# Host binding
APP_PORT=8082

# Application database connection
DB_URL=jdbc:mysql://db:3306/monster_hunting_board
DB_USER=monster_hunting_board_user
DB_PASSWORD=replace_with_strong_database_password

# MySQL
MYSQL_DATABASE=monster_hunting_board
MYSQL_USER=monster_hunting_board_user
MYSQL_PASSWORD=replace_with_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

# Authentication
JWT_SECRET=replace_with_base64_encoded_32_byte_secret